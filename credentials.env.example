# Template for the user credential store.
#
# Install on a new machine:
#     mkdir -p ~/.config/video-pipeline && chmod 700 ~/.config/video-pipeline
#     cp credentials.env.example ~/.config/video-pipeline/credentials.env
#     chmod 600 ~/.config/video-pipeline/credentials.env
#     $EDITOR ~/.config/video-pipeline/credentials.env      # fill in real values
#
# Then add to ~/.bashrc so every shell has them:
#     [ -r "$HOME/.config/video-pipeline/credentials.sh" ] && . "$HOME/.config/video-pipeline/credentials.sh"
#
# PLACEHOLDERS ONLY — never commit real values to this file.

# --- Google Gemini (narration TTS, image review, whitepaper diagram render) ---
GEMINI_API_KEY=

# --- LetterStream physical mail API (mailers/) ---
LETTERSTREAM_API_ID=
LETTERSTREAM_API_KEY=

# --- Optional STT tuning (not secret) ---
WHISPER_MODEL=small
WHISPER_DEVICE=auto
